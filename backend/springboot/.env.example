# ⚙️ DJP Backend Environment Variables Example File (.env)
# Copy this file to '.env' and modify the values for local configuration.

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Local H2 Database Configuration (used in local profile)
# (H2 uses an in-memory database by default; no host/port required)

# Production PostgreSQL / Supabase Database Configuration (used in prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=djpdb
DB_USER=postgres
DB_PASSWORD=your-super-secure-database-password-here

# Security Settings
# Allowed origins for CORS (comma-separated if multiple)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
