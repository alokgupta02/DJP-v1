SELECT -- 1. Primary Identification & Auth
       id,
       name,
       email,
       phone_number,
       role,
       provider,
       provider_id,

       -- 2. Profile Details
       dob,
       gender,
       occupation,
       bio,

       -- 3. Location & Address Details
       country,
       state,
       district,
       constituency,
       ward,
       locality,
       city,
       pincode,
       location,

       -- 4. User System Metadata
       reputation_score,
       topics,
       joined_date,
       onboarding_completed,

       -- 5. Consent & Subscription
       privacy_consent_given,
       privacy_consent_timestamp,
       subscription_status,
       subscription_ends_at,
       grace_period_ends_at
FROM djp.users
LIMIT 1000;
