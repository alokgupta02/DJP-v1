{"nodes": [{"id": "_agents_rules_boilerplate_code_guardrail", "label": "Boilerplate Code Guardrail Rule", "file_type": "document", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_rules_boilerplate_code_guardrail_lean_codebase_rule", "label": "Lean Codebase Rule", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliver working, maintainable application with minimum necessary code. Prefer simplicity over architectural purity."}, {"id": "_agents_rules_boilerplate_code_guardrail_component_creation_rules", "label": "Component Creation Rules", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create a new component only if: reused in 3+ places, or file > 250-300 lines, or distinct UI element with independent responsibility."}, {"id": "_agents_rules_boilerplate_code_guardrail_custom_hook_rules", "label": "Custom Hook Rules", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not create custom hooks unless same stateful logic is reused in 3+ places. Keep logic local until reuse is proven."}, {"id": "_agents_rules_boilerplate_code_guardrail_utility_creation_rules", "label": "Utility Creation Rules", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not create generic utils without demonstrated reuse. Utility functions should exist only when shared across multiple features."}, {"id": "_agents_rules_boilerplate_code_guardrail_state_management_principles", "label": "State Management Principles", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer local component state. Lift state only when necessary. Introduce Context/global state only when multiple unrelated components require the same mutable data."}, {"id": "_agents_rules_boilerplate_code_guardrail_styling_guidelines", "label": "Styling Guidelines", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer Tailwind utility classes directly in components. Avoid creating styling wrapper components unless they provide meaningful reusable behavior."}, {"id": "_agents_rules_boilerplate_code_guardrail_dependency_guidelines", "label": "Dependency Guidelines", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determine whether functionality can be implemented cleanly with existing dependencies or a small amount of code. Do not introduce libraries for trivial functionality."}, {"id": "_agents_rules_boilerplate_code_guardrail_refactoring_rules", "label": "Refactoring Rules", "file_type": "rationale", "source_file": ".agents/rules/boilerplate-code-guardrail.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remove dead code, duplicate code, unnecessary abstractions, merge tiny components, delete unused files/imports/variables, and reduce complexity."}], "edges": [{"source": "_agents_rules_boilerplate_code_guardrail", "ta